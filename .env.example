# Environment Variables — Cartum CMS
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
# Neon:     postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# Database provider. Accepted values: "neon" | "supabase"
DB_PROVIDER=neon

# ─── Authentication (Auth.js v5) ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Full base URL of the application (no trailing slash).
AUTH_URL=http://localhost:3000

# ─── Storage (Cloudflare R2) ─────────────────────────────────────────────────
# Optional. If not set, media upload features are disabled.
# R2_ENDPOINT format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ─── Storage (Vercel Blob) ───────────────────────────────────────────────────
# Optional. Alternative to Cloudflare R2 for media storage.
# Get your token from: Vercel Dashboard → Storage → Blob → Token
BLOB_READ_WRITE_TOKEN=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Optional. Required for password-reset and invitation emails.
# Get your key from: resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Email (AWS SES) ─────────────────────────────────────────────────────────
# Optional. Alternative email provider to Resend.
# Create IAM user with AmazonSESFullAccess and generate an access key.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=
# AWS region where your SES is configured. Defaults to us-east-1.
AWS_SES_REGION=us-east-1

# ─── Media VPS / Optimus ─────────────────────────────────────────────────────
# Optional. Enables Tier 2 media optimization (advanced image/video processing).
# Requires a running Optimus VPS instance.
MEDIA_VPS_URL=
MEDIA_VPS_KEY=

# ─── Web Migration / Scraper ─────────────────────────────────────────────────
# Optional. Required to use the Web Data Migration feature (AI-powered web scraping).
SCRAPER_API_URL=
SCRAPER_API_KEY=

# ─── Multi-project registration ──────────────────────────────────────────────
# Optional. Set to "true" to allow new users to register and create their own project.
# Set to "false" (or leave empty) to restrict registration to invitation-only.
# rute: /cartum-player
CARTUM_NEW_PLAYER=true

# ─── Help & Feedback reports ─────────────────────────────────────────────────
# Optional. Email address that receives Help section reports from users.
# If not set, the Help section will still show but reports cannot be sent.
HELP_EMAIL_AZANO=
